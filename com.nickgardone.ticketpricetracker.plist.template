<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nickgardone.ticketpricetracker</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/nickgardone/Documents/Business/Career/ticket-price-tracker/pull_and_notify.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/nickgardone/Documents/Business/Career/ticket-price-tracker/pull_notify_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/nickgardone/Documents/Business/Career/ticket-price-tracker/pull_notify_stderr.log</string>

    <!-- Do not run immediately on load — wait for scheduled time -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
